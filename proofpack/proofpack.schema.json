{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lokivelli.local/schemas/proofpack-v0.1.json",
  "title": "ProofPack v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "actor",
    "claims",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "name",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "parent_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "kind"
      ],
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "human",
            "model",
            "agent",
            "automation",
            "tool"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "release_state": {
      "enum": [
        "LOCAL_PENDING_IMPORT",
        "DRAFT",
        "CANDIDATE",
        "RELEASED",
        "PUBLISHED",
        "SUPERSEDED"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "epistemic_state"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "epistemic_state": {
            "enum": [
              "UNKNOWN",
              "OBSERVED",
              "DISCOVERED",
              "HYPOTHESIS",
              "INFERENCE",
              "SUPPORTED",
              "VERIFIED",
              "REJECTED",
              "SUPERSEDED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "timestamp",
          "kind"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "REGISTER",
              "BUILD",
              "TEST",
              "CHALLENGE",
              "VERIFICATION",
              "CORRECTION",
              "MERGE",
              "PUBLICATION",
              "ROLLBACK",
              "CUSTODY_MOVE"
            ]
          },
          "from_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_RUN"
            ]
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "predecessor_id",
          "successor_id"
        ],
        "properties": {
          "predecessor_id": {
            "type": "string"
          },
          "successor_id": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
